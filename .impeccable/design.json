  "components": [
    {
      "name": "金黄主要按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "核心动作，44px 最小触摸目标。",
      "html": "<button class=\"ds-primary\">结束本局</button>",
      "css": ".ds-primary{font-family:\"Nunito Variable\",\"PingFang SC\",\"Microsoft YaHei\",-apple-system,sans-serif;min-height:44px;padding:10px 15px;border-radius:8px;background:var(--yellow,#ffca28);color:#112b5f;border:2px solid #c99b15;font-size:14px;font-weight:850;box-shadow:inset 0 -3px 3px #b58a1529;cursor:pointer;transition:background .15s,color .15s,border-color .15s;}.ds-primary:hover:not(:disabled){filter:brightness(1.08)}.ds-primary:focus-visible{outline:2px solid var(--primary,#1762d8);outline-offset:3px;}.ds-primary:disabled{opacity:.4;cursor:not-allowed}"
    },
    {
      "name": "次级按钮",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "主题色面与描边承托辅助操作。",
      "html": "<button class=\"ds-secondary\">下载图片</button>",
      "css": ".ds-secondary{font-family:\"Nunito Variable\",\"PingFang SC\",\"Microsoft YaHei\",-apple-system,sans-serif;min-height:44px;padding:10px 15px;border-radius:8px;background:var(--bg,#f2f7ff);color:var(--ink,#112b5f);border:2px solid var(--line,#b4c9ed);font-size:14px;font-weight:750;cursor:pointer;transition:background .15s,color .15s,border-color .15s}.ds-secondary:hover:not(:disabled){background:var(--surface,#fffdf3)}.ds-secondary:focus-visible{outline:2px solid var(--primary,#1762d8);outline-offset:3px;}.ds-secondary:disabled{opacity:.4;cursor:not-allowed}"
    },
