      "css": ".ds-text{font-family:\"Nunito Variable\",\"PingFang SC\",\"Microsoft YaHei\",-apple-system,sans-serif;min-height:44px;padding:6px 10px;border:0;border-radius:6px;background:transparent;color:var(--muted,#405d88);font-size:13px;cursor:pointer;transition:background .15s,color .15s}.ds-text:hover{background:var(--surface-2,#e6efff);color:var(--ink,#112b5f)}.ds-text:focus-visible{outline:2px solid var(--primary,#1762d8);outline-offset:3px;}"
    },
