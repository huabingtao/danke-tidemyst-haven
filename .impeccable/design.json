      "css": ".ds-field{font-family:\"Nunito Variable\",\"PingFang SC\",\"Microsoft YaHei\",-apple-system,sans-serif;font-size:12px;color:var(--muted,#405d88)}.ds-field input{font-family:\"Nunito Variable\",\"PingFang SC\",\"Microsoft YaHei\",-apple-system,sans-serif;min-height:40px;width:120px;padding:7px 10px;border:1px solid var(--line,#b4c9ed);border-radius:7px;background:var(--bg,#f2f7ff);color:var(--ink,#112b5f);caret-color:var(--primary,#1762d8)}.ds-field input:focus-visible{outline:2px solid var(--primary,#1762d8);outline-offset:3px;}"
    },
